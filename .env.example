# Public browsing, papers, local projects and CSV tools work without secrets.
# Never use NEXT_PUBLIC_ for these values.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# AI endpoints stay disabled until both authentication variables are set.
APP_PASSWORD=
# Generate at least 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional: cloud project sync and durable request quota via Upstash REST.
# Both must be set together. This is a single shared workspace, not multi-tenant.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: total skill-document character budget (64000–800000).
# All selected skills are included; long SKILL.md documents are excerpted.
AI_CONTEXT_MAX_CHARS=180000
